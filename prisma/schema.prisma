// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "ERD.md" // 你也可以改成 .html, .png, .pdf 等格式
}

datasource db {
  provider = "postgresql"
}

// =========================
// Enums
// =========================

enum UserRole {
  SUPERADMIN
  ADMIN
  SALES
  SYSTEM
}

enum FactoryStatus {
  ACTIVE
  INACTIVE
}

// 母訂單
enum OrderStatus {
  PENDING        // Sales 剛建立，可修改，等待 Admin 審核
  SCHEDULED
  IN_PRODUCTION  // 其中一張子訂單變成 IN_PRODUCTION，母訂單就也變成 IN_PRODUCTION
  COMPLETED      // 所有子訂單變成 COMPLETED，母訂單變成 COMPLETED
  CANCELLED
  FAILED         // 排程失敗
}

// 子訂單 (派工單)
enum AssignmentStatus {
  SCHEDULED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

// =========================
// Conflict Issue enums
// =========================

enum ConflictIssueStatus {
  OPEN          // 剛開，還沒人留言
  IN_DISCUSSION // 至少一方留言
  RESOLVED      // 雙方同意某個 proposal，已 apply 到 Order
  CLOSED        // 關掉但沒 apply（won't fix / 取消等）
}

enum ConflictResolution {
  REDUCED_QUANTITY
  DELAYED_DUE_DATE
  CANCELLED
  WONT_FIX
}

enum ConflictIssueEventType {
  OPENED
  REASSIGNED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  ORDER_UPDATED     // 因 accept 觸發的 order 變動
  REPREVIEW_RAN
  RESOLVED
  REOPENED
  CLOSED
}

// =========================
// Models
// =========================

model User {
  id                String    @id @default(cuid())
  username          String?   @unique
  email             String    @unique
  password          String?
  role              UserRole
  group             String?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastFailedLoginAt DateTime?

  // Relations
  orders             Order[]            @relation("OrderApplicant")
  modifiedOrders     Order[]            @relation("OrderModifier")
  managedFactories   Factory[]          @relation("FactoryAdmins")
  refreshTokens      RefreshToken[]
  invitations        UserInvitation[]   @relation("InvitationUser")
  createdInvitations UserInvitation[]   @relation("InvitationCreator")
  emailChangeTokens  EmailChangeToken[]

  // Conflict issue relations
  createdIssues  ConflictIssue[]        @relation("ConflictIssueCreator")
  assignedIssues ConflictIssue[]        @relation("ConflictIssueAssignee")
  issueComments  ConflictIssueComment[]
  issueEvents    ConflictIssueEvent[]

  @@map("user")
}

model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_change_token")
}

model UserInvitation {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  createdById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user      User @relation("InvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([createdById])
  @@map("user_invitation")
}

model RefreshToken {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  userId            String
  sessionId         String?
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  replacedByTokenId String?   @unique

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken? @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces        RefreshToken? @relation("RefreshTokenReplacement")

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_token")
}

model Factory {
  id             String        @id @default(cuid())
  productionType String
  status         FactoryStatus @default(ACTIVE)
  maxCapacity    Int           @default(10000)

  admins User[] @relation("FactoryAdmins") // N-to-N: 多個 admin 可管理同一間工廠

  // Relations
  dailyCapacities DailyCapacity[]   // 該工廠每一天的產能紀錄
  assignments     OrderAssignment[] // 分配到該工廠的具體派工單

  @@map("factory")
}

// [新增] 每日產能表
model DailyCapacity {
  id          String   @id @default(cuid())
  factoryId   String
  date        DateTime // 紀錄具體是哪一天
  maxCapacity Int      // 該天總產能 (預設帶入 Factory 的 maxCapacity)
  curCapacity Int      // 該天剩餘產能 (排程時扣除)

  factory Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@unique([factoryId, date]) // 聯合唯一鍵，確保同一廠同一天只有一筆
  @@map("daily_capacity")
}

model Order {
  id               String      @id @default(cuid())
  status           OrderStatus @default(PENDING)
  dueDate          DateTime
  quantity         Int
  applicantId      String
  name             String
  type             String
  isFixed          Boolean     @default(false)
  isPrioritized    Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  lastModifiedById String?

  applicant      User  @relation("OrderApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  lastModifiedBy User? @relation("OrderModifier", fields: [lastModifiedById], references: [id], onDelete: SetNull)

  // Relations
  assignments    OrderAssignment[] // 記錄這筆訂單被拆分成哪些派工單
  conflictIssues ConflictIssue[]

  @@index([type, status])
  @@map("order")
}

// [新增] 訂單派工分配表 (支援拆單)
model OrderAssignment {
  id               String           @id @default(cuid())
  orderId          String
  status           AssignmentStatus @default(SCHEDULED)
  factoryId        String
  productionDate   DateTime
  completionDate   DateTime
  assignedQuantity Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  factory Factory @relation(fields: [factoryId], references: [id], onDelete: Restrict)

  @@map("order_assignment")
}

// =========================
// Conflict Issue models
// =========================

model ConflictIssue {
  id              String               @id @default(cuid())
  number          Int                  @unique @default(autoincrement())
  orderId         String
  title           String
  status          ConflictIssueStatus  @default(OPEN)
  resolution      ConflictResolution?
  createdById     String               // admin who opened the issue
  assigneeId      String               // sales person (defaults to order.applicantId)
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  contextSnapshot Json                 // capacity snapshot at preview time — see proposal §1.3

  order     Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User                   @relation("ConflictIssueCreator", fields: [createdById], references: [id])
  assignee  User                   @relation("ConflictIssueAssignee", fields: [assigneeId], references: [id])
  comments  ConflictIssueComment[]
  events    ConflictIssueEvent[]

  @@index([orderId])
  @@index([status])
  @@map("conflict_issue")
}

model ConflictIssueComment {
  id        String    @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  proposal  Json?     // CommentProposal: { proposal, expectedOrderUpdatedAt, status }
  editedAt  DateTime?
  createdAt DateTime  @default(now())

  issue  ConflictIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id])

  @@index([issueId])
  @@map("conflict_issue_comment")
}

model ConflictIssueEvent {
  id        String                 @id @default(cuid())
  issueId   String
  actorId   String
  type      ConflictIssueEventType
  payload   Json?
  createdAt DateTime               @default(now())

  issue ConflictIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User          @relation(fields: [actorId], references: [id])

  @@index([issueId])
  @@map("conflict_issue_event")
}

// Singleton row (id = "global") for system-wide settings
model SystemState {
  id               String    @id @default("global")
  isSimulationMode Boolean   @default(false)
  simulationDate   DateTime?

  @@map("system_state")
}

model AutoSchedulerConfig {
  id               String  @id @default(cuid())
  type             String  @unique
  isOperating      Boolean @default(true)
  frozenDays       Int     @default(0)
  productionDays   Int     @default(1)
  bufferDays       Int     @default(0)
  reschedulePolicy String  @default("GAP_FILLING")
  algorithm        String  @default("GREEDY_BEST_FIT")
  splittable       Boolean @default(true)

  @@map("auto_scheduler_config")
}
