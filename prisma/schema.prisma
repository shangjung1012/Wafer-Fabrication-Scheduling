// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================
// Enums
// =========================

enum UserRole {
  SUPERADMIN
  ADMIN
  SALES
}

enum FactoryStatus {
  ACTIVE
  INACTIVE
}

// 母訂單
enum OrderStatus {
  PENDING        // Sales 剛建立，可修改，等待 Admin 審核
  SCHEDULED
  IN_PRODUCTION  // 其中一張子訂單變成 IN_PRODUCTION，母訂單就也變成 IN_PRODUCTION
  COMPLETED      // 所有子訂單變成 COMPLETED，母訂單變成 COMPLETED
  CANCELLED
  FAILED         // 排程失敗
  CONFLICT       // 被排程踢出，需要衝突解決
}

enum ConflictCommentType {
  COMMENT    // 一般留言
  PROPOSAL   // Sales 提出的解決方案
  RESOLUTION // Admin 標記為已解決的動作紀錄
  REQUEUE    // Admin 送回 PENDING 重排的動作紀錄
}

// 子訂單 (派工單)
enum AssignmentStatus {
  SCHEDULED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

// =========================
// Models
// =========================

model User {
  id                String    @id @default(cuid())
  username          String?   @unique
  email             String    @unique
  password          String?
  role              UserRole
  group             String?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastFailedLoginAt DateTime?

  // Relations
  orders           Order[]           @relation("OrderApplicant")
  modifiedOrders   Order[]           @relation("OrderModifier")
  managedFactories Factory[]         @relation("FactoryAdmins")
  requests         OrderRequest[]    @relation("RequestApplicant")
  refreshTokens      RefreshToken[]
  invitations        UserInvitation[]   @relation("InvitationUser")
  createdInvitations UserInvitation[]   @relation("InvitationCreator")
  emailChangeTokens  EmailChangeToken[]
  conflictComments   ConflictComment[]

  @@map("user")
}

model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  newEmail  String
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_change_token")
}

model UserInvitation {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  createdById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user      User @relation("InvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([createdById])
  @@map("user_invitation")
}

model RefreshToken {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  userId            String
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  replacedByTokenId String?   @unique

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken? @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces        RefreshToken? @relation("RefreshTokenReplacement")

  @@index([userId])
  @@map("refresh_token")
}

model Factory {
  id             String        @id @default(cuid())
  productionType String
  status         FactoryStatus @default(ACTIVE)
  maxCapacity    Int           @default(10000)

  admins User[] @relation("FactoryAdmins") // N-to-N: 多個 admin 可管理同一間工廠

  // Relations
  dailyCapacities DailyCapacity[]   // 該工廠每一天的產能紀錄
  assignments     OrderAssignment[] // 分配到該工廠的具體派工單

  @@map("factory")
}

// [新增] 每日產能表
model DailyCapacity {
  id             String   @id @default(cuid())
  factoryId      String
  date           DateTime // 紀錄具體是哪一天
  maxCapacity      Int      // 該天總產能 (預設帶入 Factory 的 maxCapacity)
  curCapacity      Int      // 該天剩餘產能 (排程時扣除)
  
  factory        Factory  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  
  @@unique([factoryId, date]) // 聯合唯一鍵，確保同一廠同一天只有一筆
  @@map("daily_capacity")
}

// 刪除 productionDate, factoryId，交給OrderAssignment管理
model Order {
  id               String      @id @default(cuid())
  status           OrderStatus @default(PENDING)
  dueDate          DateTime
  quantity         Int
  applicantId      String
  name             String
  type             String
  isFixed          Boolean     @default(false)
  isPrioritized    Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  lastModifiedById String?

  applicant      User              @relation("OrderApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  lastModifiedBy User?             @relation("OrderModifier", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  
  // Relations
  assignments      OrderAssignment[] // 記錄這筆訂單被拆分成哪些派工單
  requests         OrderRequest[]
  conflictComments ConflictComment[]

  @@map("order")
}

// [新增] 訂單派工分配表 (支援拆單)
model OrderAssignment {
  id               String             @id @default(cuid())
  orderId          String
  status           AssignmentStatus   @default(SCHEDULED)  // 子訂單有自己的status，不會綁死整單操作
  factoryId        String
  productionDate   DateTime // 具體被排在哪一天生產
  assignedQuantity Int      // 分配到這間工廠這天的數量

  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  factory          Factory  @relation(fields: [factoryId], references: [id], onDelete: Restrict)

  @@map("order_assignment")
}

model OrderRequest {
  id          String @id @default(cuid())
  applicantId String
  orderId     String
  message     String
  payload     Json?

  applicant User  @relation("RequestApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_request")
}

model ConflictComment {
  id           String              @id @default(cuid())
  orderId      String
  authorId     String
  content      String
  type         ConflictCommentType @default(COMMENT)
  proposalData Json?               // { newDueDate?, newQuantity?, targetFactoryNote? }
  createdAt    DateTime            @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([orderId])
  @@map("conflict_comment")
}

// Singleton row (id = "global") for system-wide settings
model SystemState {
  id               String    @id @default("global")
  isSimulationMode Boolean   @default(false)
  simulationDate   DateTime?

  @@map("system_state")
}
