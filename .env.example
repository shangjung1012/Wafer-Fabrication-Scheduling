# Database connection string
DATABASE_URL="postgresql://wafer_user:wafer_password@localhost:5432/wafer_db?schema=public"
# DATABASE_URL="postgresql://${user}:${password}@localhost:5432/${db_name}?schema=public"


# Docker Compose PostgreSQL config
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_DB="wafer"

# =========================
# Auth (JWT, dev)
# =========================
JWT_SECRET="replace-with-a-strong-secret"
# Dev Static Token (development only). If Authorization: Bearer <token> matches this value,
# the backend will treat the request as a SUPERADMIN user for local development.
DEV_STATIC_TOKEN="dev-superadmin-static-token"
