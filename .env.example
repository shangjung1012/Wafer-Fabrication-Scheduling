# Database connection string
DATABASE_URL="postgresql://user:password@localhost:5432/wafer?schema=public"
# DATABASE_URL="postgresql://${user}:${password}@localhost:5432/${db_name}?schema=public"


# Docker Compose PostgreSQL config
POSTGRES_USER="wafer_user"
POSTGRES_PASSWORD="wafer_password"
POSTGRES_DB="wafer_db"

# =========================
# Auth (JWT, dev)
# =========================
JWT_SECRET="replace-with-a-strong-secret-at-least-32-chars"
JWT_ISSUER="wafer-auth"
JWT_AUDIENCE="wafer-api"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Argon2id password hashing parameters. Defaults are secure but can be lowered
# only for constrained local test machines.
ARGON2_MEMORY_COST="65536"
ARGON2_TIME_COST="3"
ARGON2_PARALLELISM="4"

# Dev Static Token (development only, legacy format).
# Authorization: Bearer <DEV_STATIC_TOKEN>  →  resolves as SUPERADMIN / id=dev-superadmin
DEV_STATIC_TOKEN="dev-superadmin-static-token"

# Role-encoded dev tokens (development only, no env var needed).
# Format: dev:<ROLE>:<userId>   — use directly as the Bearer token value.
# <userId> must match an existing user ID in the database (seeded via prisma/seed.ts).
#
# Seeded IDs (after running pnpm db:seed):
#   Authorization: Bearer dev:SUPERADMIN:sa-A      ← SUPERADMIN, Type A
#   Authorization: Bearer dev:SUPERADMIN:sa-B      ← SUPERADMIN, Type B
#   Authorization: Bearer dev:SUPERADMIN:sa-C      ← SUPERADMIN, Type C
#   Authorization: Bearer dev:ADMIN:admin-A1       ← ADMIN, Factory A1
#   Authorization: Bearer dev:ADMIN:admin-A2       ← ADMIN, Factory A2
#   Authorization: Bearer dev:ADMIN:admin-B1       ← ADMIN, Factory B1
#   Authorization: Bearer dev:SALES:sales-A        ← SALES, Type A
#   Authorization: Bearer dev:SALES:sales-B        ← SALES, Type B
