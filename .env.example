# Database connection string
DATABASE_URL="postgresql://wafer_user:wafer_password@localhost:5432/wafer_db?schema=public"
# DATABASE_URL="postgresql://${user}:${password}@localhost:5432/${db_name}?schema=public"


# Docker Compose PostgreSQL config
POSTGRES_USER="wafer_user"
POSTGRES_PASSWORD="wafer_password"
POSTGRES_DB="wafer_db"

# =========================
# Redis (schedule engine distributed lock)
# =========================
REDIS_URL="redis://localhost:6379"
# Set to true when REDIS_URL points to a Redis Cluster endpoint.
REDIS_CLUSTER="false"
# Optional comma-separated startup nodes for Redis Cluster.
# REDIS_CLUSTER_NODES="rediss://:<password>@redis-a.example.com:6380,rediss://:<password>@redis-b.example.com:6380"

# =========================
# Auth (JWT, dev)
# =========================
APP_BASE_URL="http://localhost:3000"
JWT_SECRET="replace-with-a-strong-secret-at-least-32-chars"
JWT_ISSUER="wafer-auth"
JWT_AUDIENCE="wafer-api"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
NEXT_TELEMETRY_DISABLED="1"

# Argon2id password hashing parameters. Defaults are secure but can be lowered
# only for constrained local test machines.
ARGON2_MEMORY_COST="65536"
ARGON2_TIME_COST="3"
ARGON2_PARALLELISM="4"

# =========================
# Mail (Azure Communication Services Email)
# =========================
AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING="endpoint=https://<resource-name>.communication.azure.com/;accesskey=<access-key>"
AZURE_COMMUNICATION_EMAIL_SENDER_ADDRESS="DoNotReply@example.com"

# =========================
# Mail fallback (SMTP)
# =========================
SMTP_FALLBACK_ENABLED="false"
SMTP_FALLBACK_HOST="smtp.gmail.com"
SMTP_FALLBACK_PORT="465"
SMTP_FALLBACK_SECURE="true"
SMTP_FALLBACK_USER="<gmail-address>"
SMTP_FALLBACK_PASSWORD="<gmail-app-password>"
SMTP_FALLBACK_FROM_ADDRESS="<from-address>"

# =========================
# Timezone
# =========================
# Let the server run in UTC timezone, and convert to business timezone in the application layer.
TZ=UTC
# UTC + 8 for TW
BUSINESS_TIMEZONE_OFFSET=8
# For node-cron
CRON_TIMEZONE="Asia/Taipei"
