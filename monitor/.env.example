# Copy to monitor/.env before starting the monitoring stack.
#
# Defaults assume:
# - Next.js runs on the host at http://localhost:3000
# - Root docker-compose.yml exposes PostgreSQL on localhost:5432
# - Root docker-compose.yml exposes Redis on localhost:6379

# =========================
# Application page probes
# =========================
MONITOR_HTTP_TARGETS="http://host.docker.internal:3000,http://host.docker.internal:3000/login,http://host.docker.internal:3000/docs"
MONITOR_SCRAPE_INTERVAL="15s"
MONITOR_EVALUATION_INTERVAL="15s"

# =========================
# Grafana
# =========================
GRAFANA_PORT="3001"
GRAFANA_ROOT_URL="http://localhost:3001"
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="admin"
GRAFANA_PROMETHEUS_URL="http://prometheus:9090"
GRAFANA_POSTGRES_HOST="host.docker.internal"
GRAFANA_POSTGRES_PORT="5432"
GRAFANA_POSTGRES_SSLMODE="disable"

# =========================
# Prometheus
# =========================
PROMETHEUS_PORT="9090"
PROMETHEUS_EXTERNAL_URL="http://localhost:9090"
PROMETHEUS_RETENTION="15d"

# =========================
# PostgreSQL / order metrics
# =========================
POSTGRES_USER="wafer_user"
POSTGRES_PASSWORD="wafer_password"
POSTGRES_DB="wafer_db"
POSTGRES_EXPORTER_DATA_SOURCE_URI="host.docker.internal:5432/wafer_db?sslmode=disable"
POSTGRES_EXPORTER_PORT="9187"
POSTGRES_EXPORTER_TARGET="postgres-exporter:9187"

# =========================
# Redis
# =========================
REDIS_EXPORTER_REDIS_ADDR="redis://host.docker.internal:6379"
REDIS_EXPORTER_PORT="9121"
REDIS_EXPORTER_TARGET="redis-exporter:9121"

# =========================
# Blackbox exporter
# =========================
BLACKBOX_EXPORTER_PORT="9115"
BLACKBOX_EXPORTER_TARGET="blackbox-exporter:9115"
